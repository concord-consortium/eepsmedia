{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteCodapResourcesEepsmedia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::codap-resources/plugins/eepsmedia/*"
    },
    {
      "Sid": "ListCodapResourcesForSync",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::codap-resources",
      "Condition": {
        "StringLike": { "s3:prefix": "plugins/eepsmedia/*" }
      }
    }
  ]
}
